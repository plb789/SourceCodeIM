<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 阶段二百五十一：桌面/角标包可见性——Android 11+ 未声明 queries 时系统过滤隐式
         广播接收者与跨应用 provider（vivo launcher 收不到角标广播，ShortcutBadger 类库
         Android 11+ 失效的已知同因）。HOME intent 覆盖所有厂商桌面，vivo launcher 包名
         显式声明双保险 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <package android:name="com.bbk.launcher2" />
    </queries>

    <!-- 阶段二百五十一：vivo 桌面角标双接口权限（vivo 官方开发文档要求）——
         BADGE_ICON=Funtouch/兼容广播接口；abe.launcher.notification.num=OriginOS
         ContentProvider 新接口（官方持续维护） -->
    <uses-permission android:name="com.vivo.notification.permission.BADGE_ICON" />
    <uses-permission android:name="com.vivo.abe.permission.launcher.notification.num" />

    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <!-- 阶段二百二十六：阿里云 EMAS 移动推送凭据（EMAS 控制台创建应用 com.gengyang.im）。
             排障结论（2026-09-30）：曾误判"切后台断线"为 EMAS 所致并摘除 MainApplication 做二分；
             实测根因是 capacitor.config.json 的 server.url 直启远程域名导致 Capacitor 插件桥接失效，
             保活服务从未启动。恢复内嵌加载后保活正常，EMAS 初始化（MainApplication）与保活共存无冲突。 -->
        <meta-data
            android:name="com.alibaba.app.appkey"
            android:value="335752905" />
        <meta-data
            android:name="com.alibaba.app.appsecret"
            android:value="d33861971d4b473f83c8279c6c574d2a" />

        <!-- 阶段二百四十一：启动广告页（微信启动页同款：LAUNCHER 入口移至本页——
             有服务端下发缓存广告图时全屏显示+右上角跳过倒计时，无缓存立即进主界面；
             APK 内置保底图经主题 windowBackground 呈现。深链仍直达 MainActivity 不经广告页） -->
        <activity
            android:name=".SplashActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <!-- 阶段二百四十一：LAUNCHER 入口已移至 SplashActivity（启动广告页），
                 主界面改为仅显式/深链进入 -->

            <!-- 阶段二百二十六：imapp 深链（scheme=imapp，BROWSABLE 供浏览器/厂商推送 Intent URI 拉起；
                 前台服务通知为显式 Intent 不依赖本 filter；前端 initNativeDeepLink 归口消费 imapp://chat?to=） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="imapp" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- 阶段二百二十五：后台保活前台服务（切后台/息屏接管长连接收消息弹通知；
             remoteMessaging 类型为 Android 14+ 消息类前台服务专用型，旧版本自动忽略；
             阶段二百五十二：叠加 mediaPlayback 类型——vivo OriginOS 对后台应用执行
             cgroup freezer 整进程冻结（实测切后台 20 秒 freeze=1，心跳/连接全停被
             CDN 30s 空闲超时掐断下线，WakeLock 无效），媒体类前台服务获 freezer 豁免
             （响铃播音频语义成立），微信同款保活手段） -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging|mediaPlayback"
            android:stopWithTask="false" />

        <!-- 阶段二百二十六：EMAS 厂商离线通道辅助弹窗（小米/华为等厂商通道推送点击经本
             Activity 中转跳深链；服务端推送须带 AndroidPopupActivity/Title/Body 参数才可达，
             与本类一一对应。exported=false 仅 SDK 内部拉起） -->
        <activity
            android:name=".EmasPopupActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- 阶段二百二十六：EMAS 自有通道（ACCS 在线）通知点击/清除回调（厂商通道点击走
             EmasPopupActivity 辅助弹窗；各厂商通道专用 action 接入对应 third-push SDK 后
             按官方文档补齐） -->
        <receiver
            android:name=".EmasMessageReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.alibaba.push2.action.NOTIFICATION_OPENED" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.alibaba.push2.action.NOTIFICATION_REMOVED" />
            </intent-filter>
        </receiver>

        <!-- 阶段二百三十八：来电通知卡片「挂断」钮广播归口（原生连接在线直达拒接信令，
             交还前台退化为深链忙态拒接；仅应用内 PendingIntent 触发，exported=false） -->
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 阶段一百九十八：语音/视频通话/会议（WebRTC getUserMedia）——Capacitor BridgeWebChromeClient
         内建 onPermissionRequest 桥接：Web 侧权限请求映射到下列 Android 运行时权限按需弹窗授权 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 阶段二百二十五：后台保活前台服务所需权限（前台服务/消息类前台服务/通知/唤醒锁） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- 阶段二百五十二：mediaPlayback 类型前台服务（Android 14+ 类型权限，缺之则
         startForeground 抛 SecurityException 服务崩溃 → 进程死 → 持续离线） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 阶段二百四十七：息屏来电原生循环振动（微信同款响铃体验；Vibrator API 必需权限） -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 阶段二百二十六：电池优化豁免申请（设置页"后台保活"引导，IM 消息类应用合规使用；
         仅用于弹出系统授权框，不自动开启） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 阶段二百三十七：后台来电全屏拉起接听画面（全屏意图通知；Android 14+ 需用户在设置授予，
         由设置页"来电弹窗"引导跳转系统设置页开启） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
</manifest>
