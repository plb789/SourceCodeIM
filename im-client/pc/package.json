{
  "name": "im-client-pc",
  "version": "1.0.0",
  "description": "即时通讯 PC 桌面客户端",
  "author": {
    "name": "山西梗阳新能源有限公司"
  },
  "winExeMeta": {
    "fileDescription": "即时通讯 PC 桌面客户端",
    "productName": "即时通讯"
  },
  "main": "loader.min.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.im.client",
    "productName": "im-client",
    "asarUnpack": [
      "shot-window-picker.ps1",
      "remote-sendinput.ps1"
    ],
    "files": [
      "!bundled/**",
      "!builder-cache/**",
      "!dist/**",
      "!loader.js",
      "!obfuscate.js",
      "!build.bat",
      "!main.js",
      "!web-cache.js",
      "!agent-executor.js",
      "!browser-manager.js",
      "!toolchain-manager.js",
      "!mcp-manager.js",
      "!node-runtime.js",
      "!lsp-manager.js",
      "!remote-input.js"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true
    },
    "extraResources": [
      {
        "from": "bundled/node-v24.14.0-win-x64.zip",
        "to": "node-runtime.zip"
      },
      {
        "from": "bundled/gcc-toolchain.zip",
        "to": "gcc-toolchain.zip"
      },
      {
        "from": "bundled/uv-runtime.zip",
        "to": "uv-runtime.zip"
      }
    ]
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "rcedit": "^4.0.1"
  }
}
