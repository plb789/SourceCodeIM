{
  "name": "im-client-pc",
  "version": "1.1.5",
  "description": "即时通 PC 桌面客户端",
  "author": {
    "name": "山西梗阳新能源有限公司"
  },
  "winExeMeta": {
    "fileDescription": "即时通 PC 桌面客户端",
    "productName": "即时通"
  },
  "main": "loader.min.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --x64"
  },
  "devDependencies": {
    "asar": "^3.2.0",
    "electron": "^44.4.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "cdt-gdb-adapter": "^1.10.0",
    "cross-spawn": "^7.0.6",
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.3",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "com.im.client",
    "productName": "im-client",
    "npmRebuild": false,
    "asarUnpack": [
      "shot-window-picker.ps1",
      "remote-sendinput.ps1",
      "node_modules/cdt-gdb-adapter/**",
      "node_modules/@vscode/debugadapter/**",
      "node_modules/@vscode/debugprotocol/**",
      "node_modules/async-mutex/**"
    ],
    "files": [
      "!bundled/**",
      "!builder-cache/**",
      "!dist/**",
      "!loader.js",
      "!obfuscate.js",
      "!build.bat",
      "!build-light.js",
      "!build-light.bat",
      "!main.js",
      "!web-cache.js",
      "!agent-executor.js",
      "!browser-manager.js",
      "!toolchain-manager.js",
      "!mcp-manager.js",
      "!node-runtime.js",
      "!lsp-manager.js",
      "!remote-input.js",
      "!debug-manager.js",
      "!updater.js",
      "!dlbt-host/**",
      "!7z/**",
      "!Driver/**",
      "!dll/**",
      "!elevator/**",
      "!updater/**",
      "!overlay-native/**",
      "!game-visible/**",
      "!shortcut-helper/**",
      "!Steam/**",
      "!hook/**",
      "!*.log",
      "!dev.bat",
      "!double.bat",
      "!publish-update.bat",
      "!installer.nsh",
      "!light-dist/**",
      "!.asar-tmp/**",
      "!app-update.yml",
      "!.gitignore"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "im-client-setup-${version}.${ext}",
      "installerIcon": "64.ico",
      "uninstallerIcon": "64.ico",
      "include": "installer.nsh"
    },
    "extraFiles": [
      {
        "from": "elevator/elevator.exe",
        "to": "elevator.exe"
      },
      {
        "from": "updater/updater.exe",
        "to": "updater.exe"
      }
    ],
    "extraResources": [
      {
        "from": "app-update.yml",
        "to": "app-update.yml"
      },
      {
        "from": "bundled/node-v24.14.0-win-x64.zip",
        "to": "node-runtime.zip"
      },
      {
        "from": "bundled/gcc-toolchain.zip",
        "to": "gcc-toolchain.zip"
      },
      {
        "from": "bundled/uv-runtime.zip",
        "to": "uv-runtime.zip"
      },
      {
        "from": "bundled/rclone.exe",
        "to": "rclone.exe"
      },
      {
        "from": "bundled/winfsp.msi",
        "to": "winfsp.msi"
      },
      {
        "from": "dlbt-host/dlbt-host.exe",
        "to": "dlbt-host/dlbt-host.exe"
      },
      {
        "from": "Steam/",
        "to": "Steam/"
      },
      {
        "from": "dlbt-host/DLBT.dll",
        "to": "dlbt-host/DLBT.dll"
      },
      {
        "from": "dlbt-host/p2p-host.exe",
        "to": "dlbt-host/p2p-host.exe"
      },
      {
        "from": "7z/7z.exe",
        "to": "7z/7z.exe"
      },
      {
        "from": "7z/7z.dll",
        "to": "7z/7z.dll"
      },
      {
        "from": "game-visible/game-visible.exe",
        "to": "game-visible/game-visible.exe"
      },
      {
        "from": "overlay-native/bin/",
        "to": "overlay-native/bin/",
        "filter": [
          "*.dll",
          "*.exe"
        ]
      },
      {
        "from": "overlay-native/native-games.json",
        "to": "overlay-native/native-games.json"
      },
      {
        "from": "Driver/",
        "to": "Driver/",
        "filter": [
          "*.exe",
          "*.sys",
          "*.cat",
          "*.inf",
          "*.dll"
        ]
      },
      {
        "from": "shortcut-helper/",
        "to": "shortcut-helper/",
        "filter": [
          "shortcut-helper.exe"
        ]
      }
    ]
  },
  "allowScripts": {
    "koffi@3.3.3": true
  }
}
